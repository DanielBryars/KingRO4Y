menu "KingRO4Y dongle"

choice DONGLE_APP_MODE
    prompt "Application mode"
    default DONGLE_APP_MODE_BLE_SIM
    help
        Selects what the dongle firmware does at boot.

    config DONGLE_APP_MODE_BLE_SIM
        bool "Phase A: BLE input -> simulated amp"
        help
            Pairs with the VOL20 BLE knob and drives a simulated amp logged
            to the console. Runs on any BLE-capable ESP32. No USB host, so
            the USB-Serial-JTAG console stays available.

    config DONGLE_APP_MODE_USB_PROBE
        bool "Phase B1: USB host read-only probe (ESP32-S3-USB-OTG)"
        depends on SOC_USB_OTG_SUPPORTED
        help
            Powers the USB-A host port, enumerates the attached Hypex amp,
            and does a single SAFE status read (0x06 0x02). No writes.
            Enabling USB host takes over the USB PHY, so the USB-Serial-JTAG
            console drops when the probe starts — watch the on-board LEDs,
            or move the console to UART0 (GPIO43/44) with an external
            USB-serial adapter.

endchoice

config DONGLE_ENABLE_DISPLAY
    bool "Enable on-board LCD (ESP32-S3-USB-OTG)"
    depends on DONGLE_APP_MODE_BLE_SIM
    default n
    help
        Show live amp/knob state on the board's 1.3" ST7789 LCD. Only
        meaningful on the ESP32-S3-USB-OTG board (SPI3, GPIO4-9).

endmenu
