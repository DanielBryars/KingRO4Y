menu "KingRO4Y dongle"

choice DONGLE_APP_MODE
    prompt "Application mode"
    default DONGLE_APP_MODE_BLE_SIM
    help
        Selects what the dongle firmware does at boot.

    config DONGLE_APP_MODE_BLE_SIM
        bool "Phase A: BLE input -> simulated amp"
        help
            Pairs with the VOL20 BLE knob and drives a simulated amp logged
            to the console. Runs on any BLE-capable ESP32. No USB host, so
            the USB-Serial-JTAG console stays available.

    config DONGLE_APP_MODE_USB_PROBE
        bool "Phase B1: USB host read-only probe (ESP32-S3-USB-OTG)"
        depends on SOC_USB_OTG_SUPPORTED
        help
            Powers the USB-A host port, enumerates the attached Hypex amp,
            and does a single SAFE status read (0x06 0x02). No writes.
            Enabling USB host takes over the USB PHY, so the USB-Serial-JTAG
            console drops when the probe starts — watch the on-board LEDs,
            or move the console to UART0 (GPIO43/44) with an external
            USB-serial adapter.

    config DONGLE_APP_MODE_USB_LIVE
        bool "Phase B2: BLE knob -> real amp over USB (ESP32-S3-USB-OTG)"
        depends on SOC_USB_OTG_SUPPORTED
        help
            The whole chain: pairs with the VOL20, drives the real FA503 over
            USB host. WRITES to the amp (Set State 0x05) under the safety
            rules in knob/docs/experiments.md — seeded from a real read, never
            speculative, input never changed, >=100 ms between writes, verified
            afterwards, and clamped to DONGLE_MAX_VOLUME_DB_X100.
            The USB-Serial-JTAG console drops when host mode starts; use the
            LCD and the on-board LEDs.

endchoice

config DONGLE_USB_HOST_START_DELAY_S
    int "Seconds to wait before starting USB host (flash window)"
    depends on DONGLE_APP_MODE_USB_PROBE || DONGLE_APP_MODE_USB_LIVE
    range 0 30
    default 5
    help
        usb_host_install() seizes the USB PHY that the USB-Serial-JTAG console
        shares, which DESTROYS the COM port a second after boot. Once that
        happens esptool has no interface left to reset the chip through, so
        flashing degrades to the BOOT-button dance and a physical replug —
        the firmware sawing off the branch it is sitting on.

        Holding off for a few seconds leaves the COM port alive long enough
        for `idf.py flash` to auto-reset into download mode as normal. Costs
        a few seconds of boot; buys back zero-touch flashing. 0 disables it
        (only sensible once the firmware is no longer being iterated on).

config DONGLE_MAX_VOLUME_DB_X100
    int "Volume ceiling the knob may command (dB x 100, e.g. -1000 = -10.00 dB)"
    depends on DONGLE_APP_MODE_USB_LIVE
    range -9900 0
    default -1000
    help
        Hard upper limit applied to every volume the dongle commands, on top
        of the protocol's own -99.00..0.00 dB range. Nothing the knob can do
        (fast spin, arithmetic bug) may exceed this. Raise it deliberately:
        0 means the knob can drive the amp to full output.

config DONGLE_ENABLE_DISPLAY
    bool "Enable on-board LCD (ESP32-S3-USB-OTG)"
    depends on SOC_USB_OTG_SUPPORTED
    default n
    help
        Show live state on the board's 1.3" ST7789 LCD. In BLE_SIM mode it
        shows the simulated amp; in USB_PROBE mode it shows what the real
        FA503 reported (useful because enabling USB host drops the console).
        Only meaningful on the ESP32-S3-USB-OTG board (SPI3, GPIO4-9).

endmenu
